{
    "name": "iamariezflores/php-sec-check",
    "description": "PHP Security Check Tool",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Aquilinoflores\\PhpSecCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aquilinoflores\\PhpSecCheck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "license": "MIT",
    "bin": [
        "bin/sec-check"
    ],
    "authors": [
        {
            "name": "Aquilino Flores",
            "email": "aries.flores@gmail.com"
        }
    ],
    "require": {
